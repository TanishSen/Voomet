# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/voomet?retryWrites=true&w=majority
DB_NAME=voomet

# Email Configuration (Gmail example - use App Password, not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where to send lead notifications
LEAD_NOTIFICATION_EMAIL=info@voomet.com

# Admin API access
ADMIN_SECRET=your-secure-admin-secret-here

# Site URL
NEXT_PUBLIC_BASE_URL=https://voomet.com
